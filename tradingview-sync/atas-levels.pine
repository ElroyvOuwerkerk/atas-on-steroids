//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  ATAS Levels — mirrors ATAS drawings (rays/lines, rectangles, HighlightY
//  zones) onto a TradingView chart, with original colours, fills, labels and
//  time anchors.
//
//  SYMBOL-AWARE: the input holds BOTH families (ES and NQ); the indicator reads
//  the chart's symbol and draws only the matching family. So one config works
//  on ES, MES, NQ and MNQ — switch the ticker and it instantly redraws the
//  right set, no re-pasting.
//
//  Data format (from the Level Sync backend; one record per object, ';'-sep):
//      family|kind|price|price2|borderRRGGBB|fillRRGGBBAA|name|startEpoch|endEpoch
//  family: ES / NQ / …   kind: L = line/ray   R = rectangle   Z = full-width zone
//  epoch 0 = no anchor (L/Z full width; R end extends right)
//
//  Feed it via the copy page (Copy all) or the Tampermonkey userscript.
// ─────────────────────────────────────────────────────────────────────────────
indicator("ATAS Levels", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ── Inputs ──
levelsStr   = input.text_area("", title = "Levels (paste 'Copy all' from the ATAS sync page)")
famOverride = input.string("Auto", title = "Chart family", options = ["Auto", "ES", "NQ"],
     tooltip = "Auto = detect from the chart symbol. Override if detection misses.")
showLabels  = input.bool(true,   title = "Show labels")
showPrices  = input.bool(true,   title = "Show price values in labels")
labelSizeS  = input.string("Normal", title = "Label size", options = ["Tiny", "Small", "Normal", "Large"])
labelOffset = input.int(3,       title = "Label offset (bars right of last candle)", minval = 0, maxval = 50)
lineWidth   = input.int(1,       title = "Line width", minval = 1, maxval = 5)
lineStyleS  = input.string("Solid", title = "Line style", options = ["Solid", "Dashed", "Dotted"])
showBoxes   = input.bool(true,   title = "Show rectangles / zones")

alertZones  = input.bool(true,  title = "Alert on highlights (zones)", group = "Alerts",
     tooltip = "Fires a TradingView alert when price enters a zone. Create one alert on this indicator with condition 'Any alert() function call'.")
alertBoxes  = input.bool(false, title = "Alert on rectangles", group = "Alerts")
alertLines  = input.bool(false, title = "Alert on lines", group = "Alerts")

// ── Chart family (mirror of the backend's _group, micro → mini) ──
familyOf(string root) =>
    r = str.upper(root)
    r == "MES" ? "ES" : r == "MNQ" ? "NQ" : r == "MGC" ? "GC" : r == "MYM" ? "YM" : r == "M2K" ? "RTY" : r

chartFam = famOverride != "Auto" ? famOverride : familyOf(syminfo.root)

// ── Helpers ──
hexDigit(string c) =>
    p = str.pos("0123456789ABCDEF", str.upper(c))
    na(p) ? 0 : p

hexByte(string h, int i) =>
    hexDigit(str.substring(h, i, i + 1)) * 16 + hexDigit(str.substring(h, i + 1, i + 2))

hexRgb(string hex) =>
    h = str.upper(hex)
    ok = str.length(h) >= 6
    r = ok ? hexByte(h, 0) : 255
    g = ok ? hexByte(h, 2) : 255
    b = ok ? hexByte(h, 4) : 255
    [r, g, b]

hexFill(string hex) =>
    [r, g, b] = hexRgb(hex)
    a = str.length(hex) >= 8 ? hexByte(str.upper(hex), 6) : 255
    color.new(color.rgb(r, g, b), 100 - int(a * 100 / 255))

styleOf(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

sizeOf(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal

// ── State ──
var line[]  lns = array.new<line>()
var label[] lbs = array.new<label>()
var box[]   bxs = array.new<box>()

// ── Render: full redraw on the last bar so add/move/delete in ATAS all sync ──
if barstate.islast
    for ln in lns
        line.delete(ln)
    array.clear(lns)
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    for bx in bxs
        box.delete(bx)
    array.clear(bxs)

    if str.length(levelsStr) > 0
        recs = str.split(levelsStr, ";")
        for rec in recs
            f = str.split(rec, "|")
            if array.size(f) >= 9 and array.get(f, 0) == chartFam
                kind     = array.get(f, 1)
                price    = str.tonumber(array.get(f, 2))
                price2   = str.tonumber(array.get(f, 3))
                borderHx = array.get(f, 4)
                fillHx   = array.get(f, 5)
                name     = array.get(f, 6)
                startSec = str.tonumber(array.get(f, 7))
                endSec   = str.tonumber(array.get(f, 8))
                if not na(price)
                    [r, g, b]  = hexRgb(borderHx)
                    col        = color.rgb(r, g, b)
                    lum        = 0.299 * r + 0.587 * g + 0.114 * b
                    txtCol     = lum > 145 ? color.black : color.white
                    hasStart   = not na(startSec) and startSec > 0
                    hasEnd     = not na(endSec) and endSec > 0
                    labelPrice = price

                    if kind == "L"
                        if hasStart
                            ln = line.new(int(startSec) * 1000, price, time, price,
                                 xloc = xloc.bar_time, extend = extend.right,
                                 color = col, width = lineWidth, style = styleOf(lineStyleS))
                            array.push(lns, ln)
                        else
                            ln = line.new(bar_index, price, bar_index + 1, price,
                                 extend = extend.both,
                                 color = col, width = lineWidth, style = styleOf(lineStyleS))
                            array.push(lns, ln)

                    else if showBoxes and not na(price2) and price2 > 0
                        top = math.max(price, price2)
                        bot = math.min(price, price2)
                        labelPrice := (top + bot) / 2
                        fillCol = str.length(fillHx) >= 6 ? hexFill(fillHx) : color.new(col, 90)
                        if kind == "Z" or not hasStart
                            bx = box.new(bar_index, top, bar_index + 1, bot,
                                 border_color = col, border_width = 1, extend = extend.both,
                                 bgcolor = fillCol)
                            array.push(bxs, bx)
                        else
                            l = int(startSec) * 1000
                            rgt = hasEnd ? int(endSec) * 1000 : time
                            bx = box.new(l, top, rgt, bot, xloc = xloc.bar_time,
                                 border_color = col, border_width = 1,
                                 extend = hasEnd ? extend.none : extend.right,
                                 bgcolor = fillCol)
                            array.push(bxs, bx)

                    // Chip text: price value (axis mark) + ATAS label.
                    // Lines always get a price chip; boxes only when named.
                    chipText = ""
                    if kind == "L"
                        priceTxt = str.tostring(price, format.mintick)
                        chipText := showPrices
                             ? (str.length(name) > 0 ? priceTxt + " · " + name : priceTxt)
                             : name
                    else if str.length(name) > 0
                        rangeTxt = str.tostring(math.min(price, price2), format.mintick)
                             + "–" + str.tostring(math.max(price, price2), format.mintick)
                        chipText := showPrices ? rangeTxt + " · " + name : name

                    if showLabels and str.length(chipText) > 0
                        lb = label.new(bar_index + labelOffset, labelPrice, chipText,
                             xloc = xloc.bar_index, yloc = yloc.price,
                             style = label.style_label_left, color = col,
                             textcolor = txtCol, size = sizeOf(labelSizeS))
                        array.push(lbs, lb)

// ─────────────────────────────────────────────────────────────────────────────
//  ALERTS — fire a TradingView alert when price ENTERS a zone/box (once on
//  entry, not while it sits inside). Set up: create one alert on this indicator
//  with condition "Any alert() function call".
// ─────────────────────────────────────────────────────────────────────────────
var float[]  aTop  = array.new<float>()
var float[]  aBot  = array.new<float>()
var string[] aName = array.new<string>()
var bool[]   aIn   = array.new<bool>()   // was price inside this object on the prior bar
var bool     aParsed = false

// Parse the alert targets once (re-runs automatically if the input or symbol changes).
if not aParsed and str.length(levelsStr) > 0
    aParsed := true
    for rec in str.split(levelsStr, ";")
        f = str.split(rec, "|")
        if array.size(f) >= 9 and array.get(f, 0) == chartFam
            k = array.get(f, 1)
            want = (k == "Z" and alertZones) or (k == "R" and alertBoxes) or (k == "L" and alertLines)
            if want
                p1 = str.tonumber(array.get(f, 2))
                p2 = str.tonumber(array.get(f, 3))
                if not na(p1)
                    hasRange = not na(p2) and p2 > 0
                    array.push(aTop, hasRange ? math.max(p1, p2) : p1)
                    array.push(aBot, hasRange ? math.min(p1, p2) : p1)
                    array.push(aName, array.get(f, 6))
                    array.push(aIn, false)

// On every bar, check entry transitions. alert() only actually fires on
// real-time bars, so history just primes the inside/outside state.
if array.size(aTop) > 0
    for i = 0 to array.size(aTop) - 1
        top = array.get(aTop, i)
        bot = array.get(aBot, i)
        touching = low <= top and high >= bot
        if touching and not array.get(aIn, i)
            nm = array.get(aName, i)
            rng = str.tostring(bot, format.mintick) + "–" + str.tostring(top, format.mintick)
            alert("ATAS level hit: " + (str.length(nm) > 0 ? nm + " (" + rng + ")" : rng) + " on " + syminfo.ticker, alert.freq_once_per_bar)
        array.set(aIn, i, touching)
