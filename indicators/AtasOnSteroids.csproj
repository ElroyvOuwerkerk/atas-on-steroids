<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>AtasOnSteroids</RootNamespace>
    <AssemblyName>AtasOnSteroids</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Path to the ATAS X application bundle DLLs.
      Override on the command line if needed:
        dotnet build -p:AtasPath="/your/custom/path"
    -->
    <AtasPath Condition="'$(AtasPath)' == ''">/Applications/ATAS X.app/Contents/MonoBundle</AtasPath>
  </PropertyGroup>

  <!-- ATAS SDK DLL references (shipped with ATAS X, not on NuGet) -->
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasPath)/ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(AtasPath)/ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>$(AtasPath)/OFT.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>$(AtasPath)/OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(AtasPath)/Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0-*" />
  </ItemGroup>

</Project>
